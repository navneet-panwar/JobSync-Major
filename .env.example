# ─────────────────────────────────────────────────────────────────────────────
# JobSync — environment template
#
# Copy this file to `backend/.env` and fill in real values:
#   PowerShell:  Copy-Item .env.example backend/.env
#   bash:        cp .env.example backend/.env
#
# NEVER commit `backend/.env` — it is git-ignored on purpose.
# Only MONGO_URI and JWT_SECRET are hard requirements; the server refuses to
# boot without them. Everything else degrades gracefully.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database (required) ──────────────────────────────────────────────────────
# MongoDB Atlas free tier (M0) or a local `mongod`.
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/jobsync?retryWrites=true&w=majority

# ── Auth (required) ──────────────────────────────────────────────────────────
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=arr_token

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allow-list. In development any localhost:* port is also
# accepted automatically; in production ONLY this list applies.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# ── Google Gemini (AI layer) ─────────────────────────────────────────────────
# Free key: https://aistudio.google.com/apikey
# Without a key the app still runs; AI endpoints return a clear error.
GEMINI_API_KEY=your-gemini-api-key
# Lead model, then comma-separated fallbacks used on 429/503/"high demand".
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash

# ── Email (optional) ─────────────────────────────────────────────────────────
# Every notification is written in-app first; email is best-effort on top.
# Leave blank to run with in-app notifications only.
# EMAIL_PROVIDER=brevo | resend | gmail-smtp | smtp
# (EMAIL_API_KEY is the SMTP password; EMAIL_USER defaults to it when blank.)
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=JobSync <no-reply@yourdomain.com>
# SMTP only (when EMAIL_PROVIDER=smtp)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
# Daily send cap so a free tier cannot be exhausted.
EMAIL_DAILY_CAP=300

# ── Public SPA URL (used for links inside emails) ────────────────────────────
CLIENT_URL=http://localhost:5173
